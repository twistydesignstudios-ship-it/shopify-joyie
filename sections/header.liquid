{%- render 'section.header' -%}

{% schema %}
{
  "name": "t:labels.header",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu_link_list",
      "label": "t:labels.navigation",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "4"
    },
    {
      "type": "color_scheme",
      "id": "cart_button_color_scheme",
      "label": "Cart Dot",
      "default": "6"
    },
    {
      "type": "header",
      "content": "t:labels.typography"
    },
    {
      "type": "select",
      "id": "type_navigation_style",
      "label": "t:labels.navigation_font",
      "default": "body",
      "options": [
        {
          "value": "body",
          "label": "t:labels.body"
        },
        {
          "value": "heading",
          "label": "t:labels.heading"
        }
      ]
    },
    {
      "type": "select",
      "id": "type_navigation_font_size",
      "label": "t:labels.navigation_size",
      "default": "md",
      "options": [
        {
          "value": "xs",
          "label": "t:labels.sizes.extra_small"
        },
        {
          "value": "sm",
          "label": "t:labels.sizes.small"
        },
        {
          "value": "md",
          "label": "t:labels.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:labels.sizes.large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "type_navigation_capitalize",
      "label": "t:labels.capitalize_navigation",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "checkbox",
      "id": "hover_menu",
      "label": "t:actions.enable_dropdown_on_hover",
      "default": true
    },
    {
      "type": "select",
      "id": "main_menu_alignment",
      "label": "t:labels.layout",
      "default": "below",
      "options": [
        {
          "value": "below",
          "label": "t:labels.logo_left_menu_below"
        },
        {
          "value": "left",
          "label": "t:labels.logo_left_menu_left"
        },
        {
          "value": "left-center",
          "label": "t:labels.logo_left_menu_center"
        },
        {
          "value": "center",
          "label": "t:labels.logo_center_menu"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "mega_products",
      "label": "t:actions.show_first_product",
      "info": "t:info.learn_mega_menu",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_sticky",
      "label": "t:actions.enable_sticky_header",
      "default": true,
      "info": "t:labels.recommended"
    },
    {
      "type": "checkbox",
      "id": "header_footer_menu",
      "label": "t:actions.show_footer_content",
      "default": true,
      "info": "t:labels.recommended"
    },
    {
      "type": "header",
      "content": "Mobile help links"
    },
    {
      "type": "text",
      "id": "mobile_track_order_text",
      "label": "Track order text",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "mobile_track_order_link",
      "label": "Track order link"
    },
    {
      "type": "text",
      "id": "mobile_help_contact_text",
      "label": "Help and contact text",
      "default": "Help & Contact"
    },
    {
      "type": "url",
      "id": "mobile_help_contact_link",
      "label": "Help and contact link"
    },
    {
      "type": "checkbox",
      "id": "sticky_index",
      "label": "t:actions.overlay_header_over_home",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_collection",
      "label": "t:actions.overlay_header_over_collection",
      "info": "t:info.if_collection_image_enabled",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item", "info": "Enter the exact top-level navigation title." },
        {
          "type": "select", "id": "columns", "label": "Columns", "default": "4",
          "options": [
            { "value": "1", "label": "1" }, { "value": "2", "label": "2" },
            { "value": "3", "label": "3" }, { "value": "4", "label": "4" },
            { "value": "5", "label": "5" }, { "value": "6", "label": "6" }
          ]
        },
        { "type": "checkbox", "id": "alphabetical_links", "label": "Alphabetical links", "default": false },
        { "type": "checkbox", "id": "show_predictive_search", "label": "Show city search", "default": false },
        { "type": "text", "id": "search_label", "label": "Search label", "default": "Find your city" },
        { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search any city or town" },
        { "type": "text", "id": "search_helper_text", "label": "Search helper text" },
        { "type": "text", "id": "browse_all_label", "label": "Browse all label", "default": "Browse all" },
        { "type": "text", "id": "search_all_cities_label", "label": "All cities link label", "default": "Search any city or town" },
        { "type": "url", "id": "search_all_cities_link", "label": "All cities link" },
        { "type": "header", "content": "Promotions" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "image_heading_1", "label": "Image 1 heading" },
        { "type": "url", "id": "image_link_1", "label": "Image 1 link" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "image_heading_2", "label": "Image 2 heading" },
        { "type": "url", "id": "image_link_2", "label": "Image 2 link" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "text", "id": "image_heading_3", "label": "Image 3 heading" },
        { "type": "url", "id": "image_link_3", "label": "Image 3 link" }
      ]
    },
    {
      "type": "logo",
      "name": "t:labels.logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:labels.logo"
        },
        {
          "type": "image_picker",
          "id": "logo-inverted",
          "label": "t:labels.white_logo",
          "info": "t:info.used_when_on_top_of_image"
        },
        {
          "type": "range",
          "id": "desktop_logo_width",
          "label": "t:labels.desktop_logo_width",
          "default": 200,
          "min": 100,
          "max": 400,
          "step": 10,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "mobile_logo_width",
          "label": "t:labels.mobile_logo_width",
          "default": 140,
          "min": 60,
          "max": 200,
          "step": 10,
          "unit": "px",
          "info": "t:info.set_as_max_width"
        }
      ]
    }
  ],
  "default": {
    "settings": {}
  },
  "disabled_on": {
    "groups": ["footer", "custom.popups"]
  }
}
{% endschema %}
