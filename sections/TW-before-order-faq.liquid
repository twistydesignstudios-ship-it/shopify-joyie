<section class="tw-order-faq" aria-labelledby="tw-order-faq-title-{{ section.id }}">
  <div class="page-width tw-order-faq__layout">
    <header class="tw-order-faq__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tw-order-faq__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="tw-order-faq-title-{{ section.id }}" class="tw-order-faq__title">{{ section.settings.heading }}</h2>

      {%- if section.settings.support_text != blank -%}
        <div class="tw-order-faq__support">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect>
            <path d="M4 7l8 6 8-6"></path>
          </svg>
          <span>{{ section.settings.support_text }}</span>
          {%- if section.settings.support_link_text != blank -%}
            <a href="{{ section.settings.support_link | default: 'mailto:support@joyie.co' }}">{{ section.settings.support_link_text }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    <div class="tw-order-faq__grid">
      {%- for block in section.blocks -%}
        <details class="tw-order-faq__item"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="tw-order-faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="tw-order-faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="tw-order-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .tw-order-faq {
    margin-top: {{ section.settings.section_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .tw-order-faq__layout {
    display: grid;
    grid-template-columns: minmax(250px, 330px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(48px, 7vw, 100px);
  }
  #shopify-section-{{ section.id }} .tw-order-faq__eyebrow {
    margin: 0 0 9px;
    color: #c65029;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__title {
    margin: 0;
    font-size: clamp(27px, 2.2vw, 34px);
    line-height: 1.18;
    letter-spacing: -.015em;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__support {
    display: flex;
    margin-top: 24px;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    color: #4a4641;
    font-size: 14px;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__support svg {
    width: 19px;
    height: 19px;
    margin-right: 2px;
    color: #c65029;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__support a {
    color: #c65029;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 40px;
    align-items: start;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__item {
    border-top: 1px solid #e8e8e1;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__item:nth-last-child(-n + 2) {
    border-bottom: 1px solid #e8e8e1;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__question {
    display: flex;
    min-height: 64px;
    padding: 16px 0;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: #1c1d1d;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__question::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .tw-order-faq__question:focus-visible {
    outline: 2px solid #c65029;
    outline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__toggle {
    position: relative;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__toggle::before,
  #shopify-section-{{ section.id }} .tw-order-faq__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform .2s ease;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  #shopify-section-{{ section.id }} details[open] .tw-order-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  #shopify-section-{{ section.id }} .tw-order-faq__answer {
    max-width: 520px;
    padding: 0 28px 20px 0;
    color: #4a4641;
    font-size: 15px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .tw-order-faq__answer p { margin: 0; }
  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .tw-order-faq__layout { grid-template-columns: 1fr; gap: 34px; }
  }
  @media screen and (max-width: 700px) {
    #shopify-section-{{ section.id }} .tw-order-faq {
      margin-top: {{ section.settings.section_gap_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tw-order-faq__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .tw-order-faq__item:nth-last-child(-n + 2) { border-bottom: 0; }
    #shopify-section-{{ section.id }} .tw-order-faq__item:last-child { border-bottom: 1px solid #e8e8e1; }
  }
{% endstyle %}

{% schema %}
{
  "name": "TW before order FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GOOD TO KNOW" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you order" },
    { "type": "text", "id": "support_text", "label": "Support text", "default": "Still unsure?" },
    { "type": "text", "id": "support_link_text", "label": "Support link text", "default": "support@joyie.co" },
    { "type": "url", "id": "support_link", "label": "Support link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "section_gap", "label": "Space above section", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "section_gap_mobile", "label": "Space above section", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add your answer here.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "TW before order FAQ" }]
}
{% endschema %}
