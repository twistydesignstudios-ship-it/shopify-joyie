<section class="tw-process" aria-labelledby="tw-process-title-{{ section.id }}">
  <div class="page-width">
    <header class="tw-process__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tw-process__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="tw-process-title-{{ section.id }}" class="tw-process__title">{{ section.settings.heading }}</h2>
    </header>

    <div class="tw-process__grid">
      {%- for block in section.blocks -%}
        <article class="tw-process__card" {{ block.shopify_attributes }}>
          <div class="tw-process__card-top">
            <span class="tw-process__icon" aria-hidden="true">
              {%- if block.settings.custom_icon != blank -%}
                {{ block.settings.custom_icon
                  | image_url: width: 104
                  | image_tag: loading: 'lazy', widths: '52,104', alt: ''
                }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'print' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 8V3.5h10V8M7 17H4.5V9.5A1.5 1.5 0 0 1 6 8h12a1.5 1.5 0 0 1 1.5 1.5V17H17"></path><rect x="7" y="13" width="10" height="7.5"></rect></svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="8.5" width="17" height="4" rx="1"></rect><path d="M5 12.5V20h14v-7.5M12 8.5V20M12 8.5C10.5 5 6.5 4.5 6.5 7S10 8.5 12 8.5zM12 8.5C13.5 5 17.5 4.5 17.5 7S14 8.5 12 8.5z"></path></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1-4.5L15.5 5a2 2 0 0 1 3 3L8 18.5zM13.5 7l3 3"></path></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            {%- if block.settings.step != blank -%}
              <span class="tw-process__step">{{ block.settings.step }}</span>
            {%- endif -%}
          </div>
          <h3 class="tw-process__card-title">{{ block.settings.heading }}</h3>
          <div class="tw-process__card-text rte">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .tw-process {
    margin-top: {{ section.settings.section_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .tw-process__header { margin-bottom: 36px; }
  #shopify-section-{{ section.id }} .tw-process__eyebrow {
    margin: 0 0 9px;
    color: #c65029;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
  }
  #shopify-section-{{ section.id }} .tw-process__title {
    margin: 0;
    font-size: clamp(27px, 2.2vw, 34px);
    line-height: 1.18;
    letter-spacing: -.015em;
  }
  #shopify-section-{{ section.id }} .tw-process__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .tw-process__card {
    padding: 30px;
    border: 1px solid #e8e8e1;
    border-radius: 12px;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .tw-process__card-top {
    display: flex;
    margin-bottom: 18px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .tw-process__icon {
    display: flex;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff4ea;
    color: #c65029;
  }
  #shopify-section-{{ section.id }} .tw-process__icon svg,
  #shopify-section-{{ section.id }} .tw-process__icon img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .tw-process__step {
    color: #bdb5aa;
    font-size: 14px;
    font-weight: 700;
  }
  #shopify-section-{{ section.id }} .tw-process__card-title {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .tw-process__card-text {
    color: #4a4641;
    font-size: 15px;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .tw-process__card-text p { margin: 0; }
  @media screen and (max-width: 800px) {
    #shopify-section-{{ section.id }} .tw-process__grid { grid-template-columns: 1fr; gap: 14px; }
  }
  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .tw-process {
      margin-top: {{ section.settings.section_gap_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tw-process__header { margin-bottom: 24px; }
    #shopify-section-{{ section.id }} .tw-process__card { padding: 22px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "TW how it is made",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT'S MADE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From your camera roll to her wall" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "section_gap", "label": "Space above section", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "section_gap_mobile", "label": "Space above section", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "step", "label": "Step number", "default": "01" },
        {
          "type": "select",
          "id": "icon",
          "label": "Default icon",
          "default": "personalize",
          "options": [
            { "value": "personalize", "label": "Personalize" },
            { "value": "print", "label": "Print" },
            { "value": "gift", "label": "Gift" }
          ]
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Overrides the default icon." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "You personalize" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your photos and text. The preview updates as you go.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "TW how it is made" }]
}
{% endschema %}
