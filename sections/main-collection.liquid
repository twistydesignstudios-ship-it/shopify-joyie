{%- render 'section.main-collection' -%}

{% schema %}
{
  "name": "t:labels.product_grid",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.filtering_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sidebar",
      "label": "t:actions.enable_filter",
      "default": true,
      "info": "t:info.allow_your_customers_to_filter"
    },
    {
      "type": "checkbox",
      "id": "collapse_filters",
      "label": "t:actions.collapse_filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "t:actions.enable_color_swatches",
      "info": "t:actions.view_setup_instructions"
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "t:actions.show_sort_options",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection_description",
      "name": "t:labels.collection_description",
      "limit": 1
    },
    {
      "type": "product_grid",
      "name": "t:labels.products",
      "settings": [
        {
          "type": "select",
          "id": "grid_style",
          "label": "t:labels.default_product_layout",
          "default": "medium",
          "options": [
            {
              "value": "large",
              "label": "t:labels.sizes.large_grid"
            },
            {
              "value": "medium",
              "label": "t:labels.sizes.small_grid"
            },
            {
              "value": "list",
              "label": "t:labels.list"
            }
          ]
        },
        {
          "type": "header",
          "content": "City poster: Build a set"
        },
        {
          "type": "checkbox",
          "id": "show_build_set",
          "label": "Show Build a set card",
          "default": true
        },
        {
  "type": "image_picker",
  "id": "build_set_image",
  "label": "Build set image"
},
        {
          "type": "text",
          "id": "build_set_eyebrow",
          "label": "Small heading",
          "default": "Build a set"
        },
        {
          "type": "text",
          "id": "build_set_heading",
          "label": "Heading",
          "default": "Where you grew up, where you met, where you live now"
        },
        {
          "type": "textarea",
          "id": "build_set_text",
          "label": "Description",
          "default": "Pick any three city posters for a gallery wall. The third one is free."
        },
        {
          "type": "text",
          "id": "build_set_button_label",
          "label": "Button label",
          "default": "Start a set"
        },
        {
          "type": "url",
          "id": "build_set_button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "build_set_background",
          "label": "Card background",
          "default": "#e7dccf"
        },
        {
          "type": "color",
          "id": "build_set_panel_background",
          "label": "Image panel background",
          "default": "#f5eee6"
        },
        {
          "type": "color",
          "id": "build_set_accent",
          "label": "Small heading color",
          "default": "#c65029"
        },
        {
          "type": "color",
          "id": "build_set_text_color",
          "label": "Text color",
          "default": "#1c1d1d"
        },
        {
          "type": "color",
          "id": "build_set_button_background",
          "label": "Button background",
          "default": "#1c1d1d"
        },
        {
          "type": "color",
          "id": "build_set_button_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        }
      ],
      "limit": 1
    },
    {
      "type": "subcollections",
      "name": "t:labels.subcollections",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:info.links_to_collections_appear_here"
        }
      ],
      "limit": 1
    }
  ]
}
{% endschema %}
