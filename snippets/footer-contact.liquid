  Renders the footer contact block for the footer.

  @param {object} block - The block object
  @param {string} [phone] - The phone number
  @param {string} [phone_note] - Small note under the phone number
  @param {string} [email] - The email address
  @param {string} [email_note] - Small note under the email address
  @param {string} [address] - The address
  @param {string} [address_link] - Map link for the address
  @param {object} [contact_page] - The contact page object
  @param {object} [chat_page] - The chat page object
  @param {string} [partner_title] - Heading for the partner links
  @param {string} [partner_signup_text] - Partner signup link text
  @param {string} [partner_signup_link] - Partner signup link URL
  @param {string} [partner_login_text] - Partner login link text
  @param {string} [partner_login_link] - Partner login link URL
  @param {string} [blocks_heading_size] - The heading size for the block

  @example
  {% render 'footer-contact', block: block %}
{%- enddoc -%}

{%- liquid
  assign phone = phone | default: block.settings.phone
  assign phone_note = phone_note | default: block.settings.phone_note
  assign email = email | default: block.settings.email
  assign email_note = email_note | default: block.settings.email_note
  assign address = address | default: block.settings.address
  assign address_link = address_link | default: block.settings.address_link
  assign contact_page = contact_page | default: block.settings.contact
  assign chat_page = chat_page | default: block.settings.chat
  assign enable_social = enable_social | default: block.settings.enable_social, allow_false: true | default: true, allow_false: true
  assign partner_title = partner_title | default: block.settings.partner_title | default: 'Partner With Us'
  assign partner_signup_text = partner_signup_text | default: block.settings.partner_signup_text
  assign partner_signup_link = partner_signup_link | default: block.settings.partner_signup_link | default: '/pages/partner-signup'
  assign partner_login_text = partner_login_text | default: block.settings.partner_login_text
  assign partner_login_link = partner_login_link | default: block.settings.partner_login_link | default: routes.account_login_url
  assign blocks_heading_size = blocks_heading_size | default: block.settings.heading_size | default: 'sm'
-%}

<div class="footer__mobile-section">
  <div class="footer__blocks--mobile">
    <div class="footer__block--mobile">
      <h2 class="footer__title heading-{{ blocks_heading_size }}">
        {% assign actions_get_in_touch = 'actions.get_in_touch' | t %}
        {% render 'utility.translate', t: actions_get_in_touch, fallback: 'Get in touch' %}
      </h2>

      <ul class="footer__menu footer__menu--underline">
        {%- if phone != blank -%}
          <li>
            <a href="tel:{{ phone | remove: ' ' | escape }}">
              <span class="icon-and-text">
                {% render 'element.icon', name: 'phone' %}
                <span class="footer__contact-copy">
                  <strong>{{ phone | escape }}</strong>
                  {%- if phone_note != blank -%}
                    <span>{{ phone_note | escape }}</span>
                  {%- endif -%}
                </span>
              </span>
            </a>
          </li>
        {%- endif -%}

        {%- if email != blank -%}
          <li>
            <a href="mailto:{{ email | escape }}">
              <span class="icon-and-text">
                {% render 'element.icon', name: 'email' %}
                <span class="footer__contact-copy">
                  <strong>{{ email | escape }}</strong>
                  {%- if email_note != blank -%}
                    <span>{{ email_note | escape }}</span>
                  {%- endif -%}
                </span>
              </span>
            </a>
          </li>
        {%- elsif contact_page != blank -%}
          <li>
            <a href="{{ contact_page.url }}">
              <span class="icon-and-text">
                {% render 'element.icon', name: 'email' %}
                <span>
                  {% assign actions_email_us = 'actions.send_us_message' | t %}
                  {% render 'utility.translate', t: actions_email_us, fallback: 'Send us a message' -%}
                </span>
              </span>
            </a>
          </li>
        {%- endif -%}

        {%- if address != blank -%}
          <li>
            {%- if address_link != blank -%}
              <a href="{{ address_link }}">
            {%- else -%}
              <div class="footer__contact-card">
            {%- endif -%}
            <span class="icon-and-text">
              <svg
                aria-hidden="true"
                focusable="false"
                role="presentation"
                class="element-icon icon-pin"
                viewBox="0 0 64 64"
              >
                <path d="M32 61s20-18.1 20-37A20 20 0 0 0 12 24c0 18.9 20 37 20 37Z"/><circle cx="32" cy="24" r="7"/>
              </svg>
              <span>{{ address | escape }}</span>
            </span>
            {%- if address_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}

        {%- comment -%} Old theme behaviour: live chat link only shows when no address is set {%- endcomment -%}
        {%- if chat_page != blank and address == blank -%}
          <li>
            <a href="{{ chat_page.url }}">
              <span class="icon-and-text">
                {% render 'element.icon', name: 'chat' %}
                <span>
                  {% assign actions_live_chat = 'actions.live_chat' | t %}
                  {% render 'utility.translate', t: actions_live_chat, fallback: 'Live chat' -%}
                </span>
              </span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>

    {% capture social_icons %}
      {% render 'social.icons', wrapper_class: 'inline-list footer__social' %}
    {% endcapture %}

    {%- if enable_social and social_icons != blank -%}
      <div class="footer__block--mobile">
        {% assign actions_follow_us = 'actions.follow_us' | t %}
        <div class="footer__title">
          {% render 'utility.translate', t: actions_follow_us, fallback: 'Follow us' %}
        </div>

        {{ social_icons }}
      </div>
    {%- endif -%}

    {%- if partner_signup_text != blank or partner_login_text != blank -%}
      <div class="footer__block--mobile footer__partner">
        <div class="footer__title">{{ partner_title | escape }}</div>

        <div class="footer__partner-links">
          {%- if partner_signup_text != blank -%}
            <a href="{{ partner_signup_link }}">{{ partner_signup_text | escape }}</a>
          {%- endif -%}

          {%- if partner_login_text != blank -%}
            <a href="{{ partner_login_link }}">{{ partner_login_text | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
