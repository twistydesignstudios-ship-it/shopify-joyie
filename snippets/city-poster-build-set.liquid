{%- liquid
  assign modifier = modifier | default: 'desktop'
  assign promo_eyebrow = promo_settings.build_set_eyebrow
  assign promo_heading = promo_settings.build_set_heading
  assign promo_text = promo_settings.build_set_text
  assign promo_button_label = promo_settings.build_set_button_label
  assign promo_button_link = promo_settings.build_set_button_link | default: collection.url
-%}

<aside
  class="tw-build-set tw-build-set--{{ modifier }}"
  aria-label="Build a city poster set"
  style="--tw-build-bg: {{ promo_settings.build_set_background | default: '#e7dccf' }}; --tw-build-panel-bg: {{ promo_settings.build_set_panel_background | default: '#f5eee6' }}; --tw-build-accent: {{ promo_settings.build_set_accent | default: '#c65029' }}; --tw-build-text: {{ promo_settings.build_set_text_color | default: '#1c1d1d' }}; --tw-build-button-bg: {{ promo_settings.build_set_button_background | default: '#1c1d1d' }}; --tw-build-button-text: {{ promo_settings.build_set_button_text_color | default: '#ffffff' }};"
>
  {% comment %} <div class="tw-build-set__visual" aria-hidden="true">
    <div class="tw-build-set__posters">
      {%- for image_index in (1..3) -%}
        {%- liquid
          case image_index
            when 1
              assign custom_image = promo_settings.build_set_image_1
            when 2
              assign custom_image = promo_settings.build_set_image_2
            when 3
              assign custom_image = promo_settings.build_set_image_3
          endcase
          assign fallback_product = collection.products[forloop.index0]
          assign poster_image = custom_image | default: fallback_product.featured_image
          assign poster_alt = custom_image.alt | default: fallback_product.title | default: promo_heading
        -%}
        {%- if poster_image != blank -%}
          <div class="tw-build-set__poster tw-build-set__poster--{{ forloop.index }}">
            {{- poster_image
              | image_url: width: 420
              | image_tag:
                loading: 'lazy',
                widths: '140, 210, 280, 420',
                sizes: '(max-width: 767px) 25vw, 150px',
                alt: poster_alt
            -}}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div> {% endcomment %}

  <div class="tw-build-set__visual" aria-hidden="true">
  {%- assign build_set_image = promo_settings.build_set_image -%}

  {%- if build_set_image != blank -%}
    <div class="tw-build-set__single-image">
      {{- build_set_image
        | image_url: width: 1000
        | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1000',
          sizes: '(max-width: 767px) 100vw, 46vw',
          alt: build_set_image.alt
      -}}
    </div>
  {%- endif -%}
</div>

  <div class="tw-build-set__content">
    {%- if promo_eyebrow != blank -%}
      <div class="tw-build-set__eyebrow">
        <span>{{ promo_eyebrow | escape }}</span>
      </div>
    {%- endif -%}
    {%- if promo_heading != blank -%}<h2>{{ promo_heading | escape }}</h2>{%- endif -%}
    {%- if promo_text != blank -%}<p>{{ promo_text | escape }}</p>{%- endif -%}
    {%- if promo_button_label != blank -%}
      <a class="tw-build-set__button" href="{{ promo_button_link }}">{{ promo_button_label | escape }}</a>
    {%- endif -%}
  </div>
</aside>

{% stylesheet %}
  .tw-build-set {
    flex: 0 0 100%;
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    margin: 22px var(--product-grid-margin) 34px;
    padding: 34px 44px;
    border-radius: 16px;
    background: var(--tw-build-bg);
  }

  .tw-build-set--mobile {
    display: none;
  }

  .tw-build-set__visual {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 240px;
    border-radius: 12px;
    background: var(--tw-build-panel-bg);
    overflow: hidden;
  }

  .tw-build-set__posters {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 18px;
    width: 100%;
  }

  .tw-build-set__poster {
    flex: 0 1 120px;
    overflow: hidden;
    background: #fffaf5;
    box-shadow: 0 4px 12px rgba(60, 40, 25, 0.24), 0 1px 2px rgba(0, 0, 0, 0.12);
  }

  .tw-build-set__poster--1,
  .tw-build-set__poster--3 {
    flex-basis: 96px;
  }

  .tw-build-set__poster img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .tw-build-set__content {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .tw-build-set__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--tw-build-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .tw-build-set h2 {
    max-width: 590px;
    margin: 0;
    color: var(--tw-build-text);
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.22;
  }

  .tw-build-set p {
    max-width: 520px;
    margin: 0;
    color: color-mix(in srgb, var(--tw-build-text) 78%, transparent);
    font-size: 16px;
    line-height: 1.6;
  }

  .tw-build-set__button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
    padding-inline: 28px;
    border-radius: 999px;
    background: var(--tw-build-button-bg);
    color: var(--tw-build-button-text);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .tw-build-set__button:hover {
    filter: brightness(1.15);
    color: var(--tw-build-button-text);
  }

  @media only screen and (max-width: 767px) {
    .tw-build-set--desktop {
      display: none;
    }

    .tw-build-set--mobile {
      display: grid;
    }

    .tw-build-set {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-block: 14px 26px;
      padding: 20px;
    }

    .tw-build-set__visual {
      min-height: 190px;
      padding: 18px 14px 0;
    }

    .tw-build-set__posters {
      gap: 10px;
    }

    .tw-build-set__poster {
      flex-basis: 92px;
    }

    .tw-build-set__poster--1,
    .tw-build-set__poster--3 {
      flex-basis: 74px;
    }

    .tw-build-set h2 {
      font-size: 24px;
    }

    .tw-build-set p {
      font-size: 14px;
    }
  }
{% endstylesheet %}
