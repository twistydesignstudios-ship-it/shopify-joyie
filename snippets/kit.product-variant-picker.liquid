{% doc %}
  Product variant picker built. Renders one fieldset per product option — swatch/button radios or a dropdown — from product.options_with_values.

  @param {object} product - Product object
  @param {string} [picker_type] - 'button' | 'dropdown'. Default: 'button'
  @param {boolean} [show_labels] - Show option name labels. Default: true
  @param {boolean} [enable_swatches] - Render values with a swatch as swatches (only for 'button' picker_type). Default: false
  @param {boolean} [enable_select_unavailable] - Keep sold-out option values selectable (marked unavailable) instead of disabling them. Default: true
  @param {boolean} [update_url] - Replace the browser URL with ?variant= on selection. Default: true
  @param {string} [legend_extra] - Markup slotted into one option's legend, after the name — a size-chart trigger, a help link. Not escaped. Requires `legend_extra_option` and `show_labels`.
  @param {string} [legend_extra_option] - Name of the option `legend_extra` attaches to, matched case-insensitively (e.g. 'Size').
  @param {string} [legacy_swatch_triggers] - Comma-separated keywords naming the options that carry legacy swatches (e.g. 'color,colour,couleur'), matched case-insensitively against any part of the option name. Requires `legacy_swatch_source`.
  @param {string} [legacy_swatch_source] - Where legacy swatches live for values that have no `value.swatch`: 'files' (Shopify Files) or 'assets' (theme assets), keyed on `{value-handle}.png`. Requires `legacy_swatch_triggers` and `enable_swatches`, and only applies to the 'button' picker_type.

  @example
  {% render 'kit.product-variant-picker', product: product, picker_type: 'button' %}
{% enddoc %}

{%- liquid
  assign picker_type = picker_type | default: 'button'
  assign show_labels = show_labels | default: true, allow_false: true
  assign enable_select_unavailable = enable_select_unavailable | default: true, allow_false: true
  assign update_url = update_url | default: true, allow_false: true

  assign stack_gap = 'lg'
  assign stack_direction = 'vertical'
  if picker_type == 'dropdown'
    assign stack_gap = 'md'
    assign stack_direction = 'horizontal'
  endif

  assign legend_extra_option_match = legend_extra_option | downcase
  assign legacy_swatch_trigger_list = legacy_swatch_triggers | downcase | split: ','
-%}

{%- unless product.has_only_default_variant -%}
  {%- capture picker_options -%}
    {%- assign visible_option_number = 0 -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name_match = option.name | downcase
        assign option_classes = ''
        if option_name_match == 'available product'
          assign option_classes = 'kit-fieldset--hidden-option'
        else
          assign visible_option_number = visible_option_number | plus: 1
          if option_name_match contains 'frame' or option_name_match contains 'color' or option_name_match contains 'style'
            assign option_classes = 'kit-fieldset--variant-cards kit-fieldset--frame'
          elsif option_name_match contains 'size'
            assign option_classes = 'kit-fieldset--variant-cards kit-fieldset--size'
          else
            assign option_classes = 'kit-fieldset--variant-cards'
          endif
        endif

        assign option_legend = nil
        if show_labels
          assign option_legend = option.name
          if option_name_match contains 'frame'
            assign option_legend = 'Frame'
          elsif option_name_match contains 'size'
            assign option_legend = 'Size'
          endif
        endif

        # Legacy swatch options are named by the caller, not detected from value.swatch
        assign option_legacy_swatch_source = nil
        if picker_type != 'dropdown' and enable_swatches and legacy_swatch_source != blank
          for legacy_swatch_trigger in legacy_swatch_trigger_list
            assign legacy_swatch_trigger_match = legacy_swatch_trigger | strip
            if legacy_swatch_trigger_match != blank and option_name_match contains legacy_swatch_trigger_match
              assign option_legacy_swatch_source = legacy_swatch_source
              break
            endif
          endfor

          if option_name_match contains 'frame' or option_name_match contains 'style'
            assign option_legacy_swatch_source = legacy_swatch_source
          endif
        endif

        # Show the selected value beside every card-style option heading
        assign option_selection = nil
        if picker_type != 'dropdown'
          assign option_selection = option.selected_value
        endif

        # legend_extra attaches to a single named option, not every fieldset
        assign option_legend_extra = nil
        if legend_extra != blank and legend_extra_option_match != blank
          if option_name_match contains legend_extra_option_match
            assign option_legend_extra = legend_extra
          endif
        endif
      -%}

      {%- capture option_content -%}
        {%- if picker_type == 'dropdown' -%}
          {%- render 'kit.product-variant-picker.dropdown',
            option: option,
            enable_select_unavailable: enable_select_unavailable
          -%}
        {%- else -%}
          {%- render 'kit.product-variant-picker.button',
            option: option,
            product: product,
            enable_swatches: enable_swatches,
            enable_select_unavailable: enable_select_unavailable,
            legacy_swatch_source: option_legacy_swatch_source
          -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- render 'kit.fieldset',
        legend: option_legend,
        legend_extra: option_legend_extra,
        selection_name: option_selection,
        legend_number: visible_option_number,
        classes: option_classes,
        content: option_content
      -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture picker_stack -%}
    {%- render 'kit.stack', gap: stack_gap, direction: stack_direction, content: picker_options, wrap: true -%}
  {%- endcapture -%}

  <kit-variant-picker
    class="kit-product-variant-picker"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-handle="{{ product.handle }}"
    data-product-url="{{ product.url }}"
    {% if update_url %}
      data-update-url
    {% endif %}
  >
    {{ picker_stack }}
    <script type="application/json" data-kit-selected-variant>
      {{- product.selected_or_first_available_variant | json -}}
    </script>
  </kit-variant-picker>

  <script type="module">
    import 'kit.product-variant-picker'
  </script>
{%- endunless -%}

{% stylesheet %}
  .kit-product-variant-picker {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .kit-picker--loading {
    opacity: var(--kit-opacity-disabled, 0.5);
    pointer-events: none;
  }

  .kit-fieldset--hidden-option {
    display: none;
  }

  .kit-product-variant-picker .kit-radio--frontend-hidden {
    display: none;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards {
    padding-top: 15px;
  }

  .product-single__meta > div:has(> .kit-product-variant-picker) {
    margin-bottom: 0px;
    padding-bottom: 28px;
    border-bottom: 1px solid #e8e8e1;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-fieldset__legend {
    width: 100%;
    align-items: center;
    margin-bottom: 0px;
  }

  .kit-product-variant-picker .kit-fieldset__legend-number {
    display: inline-flex;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    border-radius: 50%;
    background: #17191b;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-fieldset__legend-text {
    font-size: 16px;
    text-transform: uppercase;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-fieldset__legend-selection {
    margin-left: auto;
    font-size: 14px;
    font-weight: 700;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-fieldset__legend-selection::before {
    display: none;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-fieldset__legend-extra {
    margin-left: auto;
  }

  .kit-product-variant-picker .kit-fieldset--size .kit-fieldset__legend-selection {
    display: none;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-fieldset__legend-extra::before {
    display: none;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards > .kit-stack {
    display: grid;
    width: 100%;
    max-width: 100%;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-radio {
    min-width: 0;
    justify-content: center;
    padding: 14px 8px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent);
    border-radius: 10px;
    background: var(--color-secondary);
    text-align: center;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-radio:has(input:checked) {
    border-color: #c65029;
    background: color-mix(in srgb, #c65029 5%, var(--color-secondary));
    color: #c65029;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-radio > .kit-button,
  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-radio > .kit-swatch {
    box-shadow: none;
  }

  .kit-product-variant-picker .kit-fieldset--frame .kit-swatch:hover {
    outline: none;
    box-shadow: none;
  }

  .kit-product-variant-picker .kit-fieldset--variant-cards .kit-radio > .kit-button {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .kit-product-variant-picker .kit-fieldset--frame .kit-radio {
    min-height: 138px;
    padding: 8px 5px;
    flex-direction: column;
  }

  .kit-product-variant-picker .kit-fieldset--size .kit-radio {
    min-height: 150px;
    padding: 10px 5px;
  }

  .kit-product-variant-picker .kit-fieldset--frame .kit-swatch {
    width: 44px;
    height: 54px;
    border-width: 7px;
    border-radius: 0;
    border: none;
    outline: none;
  }

  .kit-product-variant-picker .kit-fieldset--frame .kit-radio:first-child .kit-swatch {
    border: 1px dashed color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .kit-product-variant-picker .kit-variant-value-name {
    display: block;
    color: var(--color-primary);
    font-size: 12px;
  }

  .kit-product-variant-picker .kit-variant-size-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .kit-product-variant-picker .kit-variant-size-card__shape {
    width: var(--size-shape-width, 13px);
    height: var(--size-shape-height, 20px);
    margin-bottom: 4px;
    border: 1px solid #aaa39b;
  }

  .kit-product-variant-picker .kit-radio:has(input:checked) .kit-variant-size-card__shape {
    border-color: #c65029;
  }

  .kit-product-variant-picker .kit-variant-size-card__primary,
  .kit-product-variant-picker .kit-variant-size-card__price {
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 700;
  }

  .kit-product-variant-picker .kit-variant-size-card__secondary {
    color: color-mix(in srgb, var(--color-primary) 68%, transparent);
    font-size: 11px;
  }

  .kit-product-variant-picker .kit-radio:has(input:checked) .kit-variant-size-card__price {
    color: #c65029;
  }

  @media only screen and (max-width: 768px) {
    .kit-product-variant-picker .kit-fieldset--variant-cards {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
    }

    .kit-product-variant-picker .kit-fieldset--variant-cards > .kit-stack {
      display: grid;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 5px;
      padding-bottom: 4px;
    }

    .kit-product-variant-picker .kit-fieldset--variant-cards .kit-radio {
      width: 100%;
      min-width: 0;
      padding: 8px 3px;
      border-radius: 7px;
    }

    .kit-product-variant-picker .kit-fieldset--frame .kit-radio,
    .kit-product-variant-picker .kit-fieldset--size .kit-radio {
      min-height: 0;
    }

    .kit-product-variant-picker .kit-fieldset--frame .kit-swatch {
      width: 38px;
      height: 48px;
    }

    .kit-product-variant-picker .kit-variant-value-name {
      font-size: 10px;
      line-height: 1.2;
    }

    .kit-product-variant-picker .kit-variant-size-card {
      gap: 2px;
    }

    .kit-product-variant-picker .kit-variant-size-card__primary,
    .kit-product-variant-picker .kit-variant-size-card__price {
      font-size: 11px;
    }

    .kit-product-variant-picker .kit-variant-size-card__secondary {
      font-size: 9px;
      line-height: 1.2;
    }
  }
{% endstylesheet %}
