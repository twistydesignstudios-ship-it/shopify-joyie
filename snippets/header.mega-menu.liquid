{%- liquid
  assign columns = block.settings.columns | default: '4'
  assign promo_count = 0
  for index in (1..3)
    assign image_key = 'image_' | append: index
    if block.settings[image_key] != blank
      assign promo_count = promo_count | plus: 1
    endif
  endfor
-%}

<div class="site-nav__dropdown megamenu megamenu--joyie text-left" {{ block.shopify_attributes }}>
  <div class="page-width">
    <div class="site-nav__dropdown-animate">
      <div class="joyie-megamenu__curated" data-mega-curated>
        {%- if block.settings.show_predictive_search -%}
          {%- render 'header.mega-search', block: block -%}
        {%- endif -%}
        <div class="joyie-megamenu__cols{% if promo_count > 0 %} joyie-megamenu__cols--with-promos{% endif %}{% if promo_count > 0 and columns == '1' %} joyie-megamenu__cols--single-with-promos{% endif %}" style="--joyie-mega-columns: {{ columns }}; --joyie-promo-count: {{ promo_count | at_least: 1 }};">
          <div class="joyie-megamenu__links{% if block.settings.alphabetical_links %} joyie-megamenu__links--alphabetical{% endif %}">
            {%- for childlink in link.links -%}
              <div class="megamenu__col">
                <div class="megamenu__col-title">
                  <a href="{{ childlink.url }}" class="site-nav__dropdown-link site-nav__dropdown-link--top-level">{{ childlink.title }}</a>
                </div>
                {%- for grandchildlink in childlink.links -%}
                  {%- if block.settings.show_predictive_search and forloop.parentloop.first and forloop.index > 8 -%}{%- break -%}{%- endif -%}
                  <a href="{{ grandchildlink.url }}" class="site-nav__dropdown-link">{{ grandchildlink.title }}</a>
                {%- endfor -%}
                {%- if block.settings.show_predictive_search and forloop.first and childlink.links.size > 8 -%}
                  <button type="button" class="joyie-megamenu__browse" data-mega-browse>{{ block.settings.browse_all_label | default: 'Browse all 50 states' }}</button>
                {%- endif -%}
                {%- if block.settings.show_predictive_search and forloop.index == 3 and block.settings.search_all_cities_link != blank -%}
                  <a class="joyie-megamenu__browse" href="{{ block.settings.search_all_cities_link }}">{{ block.settings.search_all_cities_label | default: 'Search any city or town' }}</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if promo_count > 0 -%}
            <div class="joyie-megamenu__promos{% if promo_count == 1 %} joyie-megamenu__promos--single{% endif %}">
              {%- for index in (1..3) -%}
                {%- liquid
                  assign image_key = 'image_' | append: index
                  assign heading_key = 'image_heading_' | append: index
                  assign link_key = 'image_link_' | append: index
                  assign promo_image = block.settings[image_key]
                -%}
                {%- if promo_image != blank -%}
                  <a class="joyie-megamenu__promo" href="{{ block.settings[link_key] | default: '#' }}">
                    {{ promo_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900' }}
                    {%- if block.settings[heading_key] != blank -%}<span class="joyie-megamenu__promo-title">{{ block.settings[heading_key] }}</span>{%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if block.settings.show_predictive_search -%}
        {%- assign all_states_menu = link.links.first -%}
        {%- assign all_states_columns = 5 -%}
        {%- assign all_states_rows = all_states_menu.links.size | plus: all_states_columns | minus: 1 | divided_by: all_states_columns -%}
        <div class="joyie-megamenu__all" data-mega-all hidden>
          <button type="button" class="joyie-megamenu__back" data-mega-back>&larr; Back to popular states</button>
          <div class="joyie-megamenu__all-grid" style="--joyie-all-columns: {{ all_states_columns }}; --joyie-all-rows: {{ all_states_rows }};">
            {%- for state_link in all_states_menu.links -%}
              <a href="{{ state_link.url }}" class="site-nav__dropdown-link">{{ state_link.title }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script type="module">import 'header.mega-menu'</script>
