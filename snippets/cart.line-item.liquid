{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Individual cart item display with product details, quantity controls, and removal options.

  @param {line_item} item - Cart line item object to render
  @param {number} [truncate_title] - Maximum number of characters in the product title

  @example
  {% render 'cart.line-item', item: cart.items[0] %}
{% enddoc %}

{% stylesheet %}
  /* General cart item styles */
  .cart__item {
    display: grid;
    grid-template-areas:
      'cartImage cartTitle .'
      'cartImage cartQuantity cartPrice'
      '. cartRemove cartPrice';
    grid-template-columns: 150px auto auto;
    grid-column-gap: 20px;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid;
    border-bottom-color: color-mix(in srgb, var(--color-primary) var(--shade-12), var(--color-secondary));

    /*Smaller image in drawer*/
    .site-header__cart & {
      grid-template-areas:
        'cartImage cartTitle cartTitle'
        'cartImage cartQuantity cartPrice'
        'cartImage cartRemove cartPrice';
      grid-template-columns: 88px minmax(0, 1fr) auto;
      grid-column-gap: 14px;
      align-items: start;
      padding-block: 20px;
      margin-bottom: 0;
      transition: opacity 0.2s ease;
    }

    .site-header__cart &.is-loading {
      opacity: 0.45;
      pointer-events: none;
    }

    @media only screen and (max-width: 959px) {
      grid-template-areas:
        'cartImage cartTitle cartTitle'
        'cartImage cartQuantity cartPrice'
        'cartImage cartRemove cartPrice';
    }

    &:last-of-type {
      border-bottom: 0;
    }
  }

  .cart__image {
    grid-area: cartImage;
    align-self: flex-start;
    pointer-events: none;

    & a {
      position: relative;
      display: block;
      width: 100%;
      height: 100px;
    }

    .site-header__cart & a {
      height: 88px;
      overflow: hidden;
      border-radius: 0;
      background: color-mix(in srgb, var(--color-primary) 4%, var(--color-secondary));
    }

    & .image-wrap img,
    & img {
      position: absolute;
      width: 100%;
      height: 100%;
      left: 0;
      top: 0;
      display: block;
      object-fit: contain;
    }
  }

  .cart__item-title {
    grid-area: cartTitle;
  }

  .cart__item-quantity {
    grid-area: cartQuantity;
  }

  .cart__item-remove {
    grid-area: cartRemove;

    & a {
      display: inline-block;
      margin-top: 10px;
    }

    .cart__drawer-form & {
      display: block;
    }

    .cart__drawer-form & a {
      margin-top: 8px;
      font-size: calc(var(--element-text-font-size--body-md) - 2px);
      opacity: 0.7;
    }
  }

  .cart__item-price {
    grid-area: cartPrice;
  }

  .cart__item-name {
    display: block;
    font-size: calc(var(--element-text-font-size--body-md) + 1px);
    margin-bottom: 8px;
  }

  .cart__item--variants {
    font-size: calc(var(--element-text-font-size--body-md) - 2px);
    margin-bottom: 10px;

    & span {
      font-weight: var(--element-text-font-weight--heading);
    }
  }

  .cart__price {
    display: block;

    &:not(.cart__price--strikethrough) {
      font-weight: var(--element-text-font-weight--heading);
      font-size: calc(var(--element-text-font-size--body-md) + 2px);
    }
  }

  .cart__price--strikethrough {
    text-decoration: line-through;
  }

  /* Cart properties */
  .cart__item--properties {
    font-size: calc(var(--element-text-font-size--body-md) - 2px);
    margin-bottom: 10px;
    line-height: 1.3;

    & span {
      font-weight: 700;
    }
  }

  .site-header__cart .cart__item-name {
    margin-bottom: 5px;
    line-height: 1.3;
  }

  .site-header__cart .cart__item--variants,
  .site-header__cart .cart__item--properties {
    margin-bottom: 6px;
    line-height: 1.35;
  }

  .site-header__cart .cart__item-price {
    padding-top: 2px;
    white-space: nowrap;
  }

  @media only screen and (max-width: 380px) {
    .site-header__cart .cart__item {
      grid-template-columns: 76px minmax(0, 1fr) auto;
      grid-column-gap: 10px;
    }

    .site-header__cart .cart__image a {
      height: 76px;
    }
  }
{% endstylesheet %}

{%- liquid
  assign item = item | default: blank
  assign customization_image = item.properties._customization_image
  assign cart_item_image = item.image | default: item.product.featured_image
-%}

<div class="cart__item" data-key="{{ item.key }}">
  <div class="cart__image">
    {% if customization_image != blank %}
      <a href="{{ customization_image | escape }}" class="image-wrap tee-img-link" target="_blank" rel="noopener">
        <img
          src="{{ customization_image | escape }}"
          alt="{{ item.product.title | escape }} customized preview"
          class="image-element animate-instant tee-img-fluid"
          width="180"
          height="180"
          loading="eager"
        >
      </a>
    {% elsif cart_item_image != blank %}
      <a href="{{ item.url }}" class="image-wrap">
        {%- render 'element.image',
          img: cart_item_image,
          sizes: '150px',
          alt: item.product.title,
          widths: '180, 360, 540',
          classlist: 'animate-instant'
        -%}
      </a>
    {% endif %}
  </div>

  <div class="cart__item-title">
    <a href="{{ item.url }}" class="cart__item-name">
      {%- if truncate_title -%}
        {{ item.product.title | truncate: truncate_title }}
      {%- else -%}
        {{ item.product.title }}
      {%- endif -%}
    </a>

    {%- unless item.product.has_only_default_variant -%}
      <div class="cart__item--variants">
        {%- for option in item.options_with_values -%}
          <div>
            <span>{{ option.name }}:</span> {{ option.value }}
          </div>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    {%- if item.selling_plan_allocation != empty -%}
      <div class="cart__item--variants">
        {{ item.selling_plan_allocation.selling_plan.name }}
      </div>
    {%- endif -%}

    {%- assign has_visible_item_properties = false -%}
    {%- capture visible_item_properties -%}
      {% for p in item.properties %}
        {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
        {% unless p.last == blank or first_character_in_key == '_' %}
          {%- assign has_visible_item_properties = true -%}
          <div class="cart__item--properties">
            <span>{{ p.first }}:</span>
            {% if p.last contains '/uploads/' %}
              <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
            {% else %}
              {{ p.last }}
            {% endif %}
          </div>
        {% endunless %}
      {% endfor %}
    {%- endcapture -%}

    {%- if has_visible_item_properties -%}
      <details class="cart__item-details">
        <summary class="cart__item-details-toggle">
          <span class="cart__item-details-label cart__item-details-label--closed">View details</span>
          <span class="cart__item-details-label cart__item-details-label--open">Collapse details</span>
          <span class="cart__item-details-icon" aria-hidden="true"></span>
        </summary>
        <div class="cart__item-details-content">
          {{ visible_item_properties }}
        </div>
      </details>
    {%- endif -%}
  </div>

  <div class="cart__item-quantity">
    {%- assign quantity_selector_id = 'cart_updates_' | append: item.key -%}
    {% capture quantity_selector_attributes %}
      for="{{ quantity_selector_id }}"
    {% endcapture -%}

    {%- render 'element.text',
      as: 'label',
      locale: 'labels.quantity',
      text: 'Quantity',
      attributes: quantity_selector_attributes,
      visually_hidden: true
    -%}
    {%- render 'element.quantity-selector',
      id: quantity_selector_id,
      name: 'updates[]',
      value: item.quantity,
      min: 0,
      cart_item_key: item.key
    -%}
  </div>

  <div class="cart__item-remove">
    <a href="{{ routes.cart_change_url }}?id={{ item.key }}&amp;quantity=0" class="text-link" data-cart-remove>
      {% render 'utility.translate', key: 'actions.remove', fallback: 'Remove' %}
    </a>
  </div>

  <div class="cart__item-price text-right">
    {% if item.original_price != item.final_price %}
      {%- render 'element.text', locale: 'labels.regular_price', text: 'Regular price', visually_hidden: true -%}
      {%- render 'element.price', classlist: 'cart__price', price: item.original_price, strikethrough: true -%}

      {%- render 'element.text', locale: 'labels.sale_price', text: 'Sale price', visually_hidden: true -%}
      {%- render 'element.price', classlist: 'cart__price cart__discount', price: item.final_price -%}
    {% else %}
      {%- render 'element.price', classlist: 'cart__price', price: item.original_price -%}
    {% endif %}

    {%- if item.unit_price_measurement != blank -%}
      {%- capture unit_price_base_unit -%}
        <span class="product__unit-base--{{ section.id }}">
          {%- if item.unit_price_measurement -%}
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{ item.unit_price_measurement.reference_value }}
            {%- endif -%}
            {{ item.unit_price_measurement.reference_unit }}
          {%- endif -%}
        </span>
      {%- endcapture -%}

      <span class="product__unit-price">{{ item.unit_price | money }}/{{ unit_price_base_unit }}</span>
    {%- endif -%}

    {%- if item.line_level_discount_allocations != blank -%}
      {%- for discount_allocation in item.line_level_discount_allocations -%}
        <small class="cart__discount">
          {{- discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small
        >
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
